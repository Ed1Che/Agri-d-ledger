# ── Sepolia Testnet (Ethereum) ────────────────────────────────────────────────
# Get RPC from Alchemy or Infura: https://www.alchemy.com
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# 64-character hex private key (without 0x prefix)
SEPOLIA_PRIVATE_KEY=

# ── Polygon Mainnet ────────────────────────────────────────────────────────────
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
POLYGON_PRIVATE_KEY=

# ── Amoy Testnet (Polygon testnet, replaces Mumbai) ───────────────────────────
AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY
AMOY_PRIVATE_KEY=

# ── Etherscan / Polygonscan API (for contract verification) ───────────────────
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=

# ── Gas Reporting ─────────────────────────────────────────────────────────────
# Set any value to enable gas reporting during tests
# REPORT_GAS=true

# ── Deployed Contract Addresses (filled after deployment) ─────────────────────
# IDENTITY_REGISTRY_ADDRESS=
# PRODUCT_REGISTRY_ADDRESS=
# CHAIN_OF_CUSTODY_ADDRESS=
# QUALITY_VERIFICATION_ADDRESS=
# PAYMENT_ESCROW_ADDRESS=
