# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agridl

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT (RSA key pair) ────────────────────────────────────────────────────────
# Generate with: npm run keys:generate --workspace=apps/api
JWT_PRIVATE_KEY=<base64-encoded PEM private key>
JWT_PUBLIC_KEY=<base64-encoded PEM public key>
JWT_ISSUER=agridl-api
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=<service_role key from Supabase dashboard>

# ── Internal service auth ─────────────────────────────────────────────────────
# Shared secret between api <-> ussd services
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=<32+ random bytes hex string>

# ── CORS ──────────────────────────────────────────────────────────────────────
WEB_APP_URL=http://localhost:3000

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Blockchain ────────────────────────────────────────────────────────────────
# RPC endpoint for the target network (Sepolia for testnet, Polygon Mainnet for prod)
BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/<your-infura-project-id>
# Separate deployer/relayer wallet — NEVER reuse the Hardhat default key in prod
# Generate with: openssl rand -hex 32  (prefix with 0x)
BLOCKCHAIN_PRIVATE_KEY=0x<64-hex-chars>
# Deployed contract address (populated after: npm run deploy --workspace=apps/blockchain)
PAYMENT_ESCROW_ADDRESS=0x<40-hex-chars>

# ── ML service ────────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000

# ── Logging ───────────────────────────────────────────────────────────────────
# Levels: error | warn | info | http | debug
LOG_LEVEL=info

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
