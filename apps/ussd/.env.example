# apps/ussd/.env.example
# Copy to .env and fill in your values

# ── Supabase (direct access for USSD tables) ──────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=<anon key or service_role key from Supabase dashboard>

# ── Express API (internal) ────────────────────────────────────────────────────
INTERNAL_API_URL=http://localhost:3001
# Must match INTERNAL_API_SECRET in apps/api/.env
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=<32+ random bytes hex string>

# ── Africa's Talking ──────────────────────────────────────────────────────────
AT_API_KEY=<Africa's Talking API key (use sandbox key for dev)>
AT_USERNAME=sandbox

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3002
NODE_ENV=development
