# apps/iot/.env.example
# Copy to .env and fill in your values

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=<service_role key from Supabase dashboard>

# ── Africa's Talking (SMS notifications to farmers) ───────────────────────────
AT_API_KEY=<Africa's Talking API key (use sandbox key for dev)>
AT_USERNAME=sandbox

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3003
NODE_ENV=development
