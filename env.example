# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_VERSION=v1

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://agridl:secret@localhost:5432/agridl_db"

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT ──────────────────────────────────────────────────────────────────
# Generated via: npm run keys:generate
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ISSUER=agri-dl
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=7

# ── Africa's Talking ──────────────────────────────────────────────────────
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=sandbox
AT_USSD_CODE=*384#
AT_SENDER_ID=AGRIDL
AT_CALLBACK_SECRET=your_webhook_secret

# ── Polygon / Blockchain ─────────────────────────────────────────────────
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_CHAIN_ID=80002
LEDGER_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
ZK_VERIFIER_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
LEDGER_WALLET_PRIVATE_KEY=your_wallet_private_key

# ── ML Service ───────────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=your_ml_service_key

# ── Monitoring ───────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
LOG_LEVEL=info

# ── CORS ─────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://app.agridledger.co.ke
